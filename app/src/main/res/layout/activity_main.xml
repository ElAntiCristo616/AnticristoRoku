<?xml version="1.0" encoding="utf-8"?>
<!-- Estructura copiada del control remoto de la app oficial de Roku
     (barra superior, fila de iconos, atrás/inicio, D-pad en cruz,
     rejilla de botones, hoja «Mi Roku»), con los colores navideños
     de Anticristo Roku. Sin micrófono ni audífonos: esas funciones
     son exclusivas de la app oficial. Sin botón de guía: ECP no
     tiene tecla Guide. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <com.elanticristo616.roku.GarlandView
                android:id="@+id/garlandView"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <!-- Barra superior: cerrar | nombre de la tele | apagar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCerrar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="✕"
                    android:textSize="20sp"
                    app:backgroundTint="@color/pine_light"
                    app:cornerRadius="24dp" />

                <TextView
                    android:id="@+id/tvNombreTele"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="● Sin tele"
                    android:textColor="@color/snow_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPower"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="⏻"
                    android:textSize="20sp"
                    app:backgroundTint="@color/red_accent"
                    app:cornerRadius="24dp" />
            </LinearLayout>

            <!-- Mi tele -->
            <LinearLayout
                android:id="@+id/miTeleCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mi tele"
                    android:textColor="@color/gold"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Sin tele conectada. Toca «Buscar teles»."
                    android:textColor="@color/snow_white"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/searchControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBuscar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Buscar teles"
                        app:backgroundTint="@color/red_accent" />

                    <LinearLayout
                        android:id="@+id/devicesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="O escribe la IP de tu tele"
                        android:textColor="@color/sage"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etIpManual"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/card_bg"
                        android:hint="192.168.1.5"
                        android:inputType="text"
                        android:padding="12dp"
                        android:textColor="@color/snow_white"
                        android:textColorHint="@color/sage" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConectarIp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Conectar por IP"
                        app:backgroundTint="@color/pine_light" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="La IP está en la tele: Ajustes → Red → Acerca de."
                        android:textColor="@color/sage"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCambiarTele"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Cambiar de tele"
                    android:visibility="gone"
                    app:backgroundTint="@color/pine_light" />
            </LinearLayout>

            <!-- Control remoto -->
            <LinearLayout
                android:id="@+id/remoteSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Fila de iconos: buscar, teclado, ajustes -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBuscarTop"
                        android:layout_width="56dp"
                        android:layout_height="48dp"
                        android:text="🔍"
                        android:textSize="20sp"
                        app:backgroundTint="@color/pine_light"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTecladoIcono"
                        android:layout_width="56dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="24dp"
                        android:text="⌨"
                        android:textSize="20sp"
                        app:backgroundTint="@color/pine_light"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAjustesIcono"
                        android:layout_width="56dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="24dp"
                        android:text="⚙"
                        android:textSize="20sp"
                        app:backgroundTint="@color/pine_light"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <!-- Atrás | Inicio (sin guía: ECP no tiene tecla Guide) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBack"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="← Atrás"
                        android:textSize="16sp"
                        app:backgroundTint="@color/pine_light"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHome"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="⌂ Inicio"
                        android:textSize="16sp"
                        app:backgroundTint="@color/pine_light"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <!-- D-pad en cruz con OK en el centro -->
                <GridLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:columnCount="3"
                    android:rowCount="3">

                    <com.google.android.material.button.MaterialButton
                        android:layout_width="80dp"
                        android:layout_height="72dp"
                        android:enabled="false"
                        android:visibility="invisible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUp"
                        android:layout_width="80dp"
                        android:layout_height="72dp"
                        android:text="▲"
                        android:textSize="22sp"
                        app:backgroundTint="@color/pine_light"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:layout_width="80dp"
                        android:layout_height="72dp"
                        android:enabled="false"
                        android:visibility="invisible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLeft"
                        android:layout_width="80dp"
                        android:layout_height="72dp"
                        android:text="◀"
                        android:textSize="22sp"
                        app:backgroundTint="@color/pine_light"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOk"
                        android:layout_width="80dp"
                        android:layout_height="72dp"
                        android:text="OK"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/red_accent"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRight"
                        android:layout_width="80dp"
                        android:layout_height="72dp"
                        android:text="▶"
                        android:textSize="22sp"
                        app:backgroundTint="@color/pine_light"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:layout_width="80dp"
                        android:layout_height="72dp"
                        android:enabled="false"
                        android:visibility="invisible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDown"
                        android:layout_width="80dp"
                        android:layout_height="72dp"
                        android:text="▼"
                        android:textSize="22sp"
                        app:backgroundTint="@color/pine_light"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:layout_width="80dp"
                        android:layout_height="72dp"
                        android:enabled="false"
                        android:visibility="invisible" />
                </GridLayout>

                <!-- Rejilla: repetir, opciones, retroceder, play/pausa,
                     adelantar, silencio, volumen −, volumen + -->
                <GridLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:columnCount="3"
                    android:rowCount="3">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRepetir"
                        android:layout_width="80dp"
                        android:layout_height="64dp"
                        android:text="↻"
                        android:textSize="22sp"
                        app:backgroundTint="@color/pine_light"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnInfo"
                        android:layout_width="80dp"
                        android:layout_height="64dp"
                        android:text="*"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/pine_light"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:layout_width="80dp"
                        android:layout_height="64dp"
                        android:enabled="false"
                        android:visibility="invisible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRev"
                        android:layout_width="80dp"
                        android:layout_height="64dp"
                        android:text="◀◀"
                        android:textSize="18sp"
                        app:backgroundTint="@color/pine_light"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlayPause"
                        android:layout_width="80dp"
                        android:layout_height="64dp"
                        android:text="▶ ❚❚"
                        android:textSize="18sp"
                        app:backgroundTint="@color/pine_light"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFwd"
                        android:layout_width="80dp"
                        android:layout_height="64dp"
                        android:text="▶▶"
                        android:textSize="18sp"
                        app:backgroundTint="@color/pine_light"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMute"
                        android:layout_width="80dp"
                        android:layout_height="64dp"
                        android:text="🔇"
                        android:textSize="20sp"
                        app:backgroundTint="@color/pine_light"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVolDown"
                        android:layout_width="80dp"
                        android:layout_height="64dp"
                        android:text="🔉"
                        android:textSize="20sp"
                        app:backgroundTint="@color/pine_light"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVolUp"
                        android:layout_width="80dp"
                        android:layout_height="64dp"
                        android:text="🔊"
                        android:textSize="20sp"
                        app:backgroundTint="@color/pine_light"
                        app:cornerRadius="12dp" />
                </GridLayout>
            </LinearLayout>

            <!-- Hoja «Mi Roku» -->
            <LinearLayout
                android:id="@+id/miRokuCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <View
                    android:layout_width="48dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/handle_bg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Mi Roku"
                    android:textColor="@color/snow_white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accesos directos, mandar videos, apps y más"
                    android:textColor="@color/sage"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/estadoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/snow_white"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Actualizar estado"
                    app:backgroundTint="@color/pine_light" />

                <!-- Mandar YouTube -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Mandar YouTube"
                    android:textColor="@color/gold"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etYouTube"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/card_bg"
                    android:hint="Pega el enlace del video de YouTube"
                    android:inputType="textUri"
                    android:padding="12dp"
                    android:textColor="@color/snow_white"
                    android:textColorHint="@color/sage" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnYouTube"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Mandar a la tele"
                    app:backgroundTint="@color/red_accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNetflix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Abrir Netflix en la tele"
                    app:backgroundTint="@color/pine_light" />

                <!-- Mandar video o foto -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Mandar video o foto del celular"
                    android:textColor="@color/gold"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnElegirVideo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Elegir video del celular"
                    app:backgroundTint="@color/red_accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnElegirFoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Elegir foto del celular"
                    app:backgroundTint="@color/red_accent" />

                <EditText
                    android:id="@+id/etUrlDirecta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/card_bg"
                    android:hint="O pega una URL directa de video (mp4)"
                    android:inputType="textUri"
                    android:padding="12dp"
                    android:textColor="@color/snow_white"
                    android:textColorHint="@color/sage" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUrlDirecta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Mandar URL a la tele"
                    app:backgroundTint="@color/pine_light" />

                <TextView
                    android:id="@+id/mediaStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/sage"
                    android:textSize="14sp" />

                <!-- Apps de la tele -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Apps de la tele"
                    android:textColor="@color/gold"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnActualizarApps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Actualizar apps"
                    app:backgroundTint="@color/pine_light" />

                <LinearLayout
                    android:id="@+id/appsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Teclado -->
                <LinearLayout
                    android:id="@+id/tecladoSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Escribir en la tele"
                        android:textColor="@color/gold"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etTeclado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/card_bg"
                        android:hint="Escribe aquí para buscar en la tele"
                        android:padding="12dp"
                        android:textColor="@color/snow_white"
                        android:textColorHint="@color/sage" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTeclado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Escribir en la tele"
                        app:backgroundTint="@color/pine_light" />
                </LinearLayout>
            </LinearLayout>

            <!-- Ayuda -->
            <LinearLayout
                android:id="@+id/ayudaCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Si no conecta"
                    android:textColor="@color/gold"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="En la tele ve a Ajustes → Sistema → Ajustes avanzados del sistema → Control por apps móviles → Activado. La tele y el celular deben estar en el mismo Wi-Fi y la tele prendida."
                    android:textColor="@color/sage"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Si la búsqueda no encuentra la tele, escribe su IP a mano arriba. La IP está en la tele: Ajustes → Red → Acerca de."
                    android:textColor="@color/sage"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Duplicar la pantalla completa no se puede desde ninguna app: eso solo lo hace el sistema del celular. Esta app manda videos y controla la tele."
                    android:textColor="@color/sage"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Anticristo Roku v1.0.1 — Sin cuentas, sin anuncios"
                android:textColor="@color/sage"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <com.elanticristo616.roku.SnowView
        android:id="@+id/snowView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>
